# ===================================================
# Café Point — MERN Stack Environment Variables
# ===================================================

# ----------------- Backend Configuration -----------------
# Server port (default: 5000)
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/cafe_ordering
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cafe_ordering?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cafe_ordering

# Runtime Environment (development | production)
NODE_ENV=development

# ----------------- Frontend Configuration -----------------
# Base API URL used by Vite frontend client (defaults to /api via proxy)
VITE_API_BASE_URL=/api
