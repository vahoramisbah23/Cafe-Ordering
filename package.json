{
  "name": "cafe-ordering-mern",
  "version": "1.0.0",
  "description": "Full-stack Café Ordering Application built with MERN stack",
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "seed": "cd server && npm run seed",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "build:client": "cd client && npm run build"
  },
  "keywords": [
    "mern",
    "react",
    "node",
    "express",
    "mongodb",
    "cafe-ordering",
    "ecommerce"
  ],
  "author": "Antigravity Pair Programmer",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
